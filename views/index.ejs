<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>
        <%= title %>
    </title>


    <!-- Connects the page to the CSS - Osa -->
    <link rel="stylesheet"
          type="text/css"
          href="/stylesheet/style.css">


    <!-- Loads saved assignment functions - Osa -->
    <script src="/stylesheet/javascripts/storage.js"></script>


    <!-- Builds the dashboard - Osa -->
    <script src="/stylesheet/javascripts/home.js"></script>

</head>


<body>


<!-- Top navigation bar - Osa -->
<header>

    <!-- Website logo and name - Osa -->
    <div id="brand">

        <div id="logo">
            TI
        </div>


        <div id="brand-text">

            <h1>
                TrackIt
            </h1>

            <p>
                Assignment Tracker
            </p>

        </div>

    </div>


    <!-- Navigation links - Osa -->
    <nav>

        <a href="/">
            Dashboard
        </a>


        <!-- Opens the assignment list - Zaki -->
        <a href="/assignments">
            Assignments
        </a>


        <a href="/create"
           class="nav-button">

            + Create Assignment

        </a>

    </nav>

</header>


<main>


    <!-- Main dashboard introduction - Osa -->
    <section id="hero">

        <div class="hero-text">

            <p class="small-heading">
                STUDENT DASHBOARD
            </p>


            <h2>
                Stay on top of your school work.
            </h2>


            <p>
                Track assignments, due dates,
                priorities, and progress from
                one simple dashboard.
            </p>

        </div>


        <a href="/create"
           class="primary-button">

            + New Assignment

        </a>

    </section>


    <!-- Assignment totals - Osa -->
    <section id="summary-section">


        <div class="summary-box">

            <p>
                Total Assignments
            </p>

            <h2 id="totalCount">
                0
            </h2>

        </div>


        <div class="summary-box">

            <p>
                To Do
            </p>

            <h2 id="todoCount">
                0
            </h2>

        </div>


        <div class="summary-box">

            <p>
                In Progress
            </p>

            <h2 id="progressCount">
                0
            </h2>

        </div>


        <div class="summary-box">

            <p>
                Completed
            </p>

            <h2 id="completedCount">
                0
            </h2>

        </div>


    </section>


    <!-- Assignment status board - Osa -->
    <section class="dashboard-section">


        <div class="section-heading">

            <p class="small-heading">
                ASSIGNMENT BOARD
            </p>


            <h2>
                Current Assignments
            </h2>

        </div>


        <div id="board">


            <!-- To Do column - Osa -->
            <div class="status-column todo-column">

                <div class="column-title">

                    <span class="status-dot todo-dot">
                    </span>

                    To Do

                    <span id="todoColumnCount"
                          class="column-count">
                        0
                    </span>

                </div>


                <div id="todoAssignments">

                </div>

            </div>


            <!-- In Progress column - Osa -->
            <div class="status-column progress-column">

                <div class="column-title">

                    <span class="status-dot progress-dot">
                    </span>

                    In Progress

                    <span id="progressColumnCount"
                          class="column-count">
                        0
                    </span>

                </div>


                <div id="progressAssignments">

                </div>

            </div>


            <!-- Completed column - Osa -->
            <div class="status-column complete-column">

                <div class="column-title">

                    <span class="status-dot complete-dot">
                    </span>

                    Completed

                    <span id="completeColumnCount"
                          class="column-count">
                        0
                    </span>

                </div>


                <div id="completedAssignments">

                </div>

            </div>


        </div>

    </section>


    <!-- Assignment table - Osa -->
    <section class="dashboard-section">


        <div class="section-heading">

            <div>

                <p class="small-heading">
                    OVERVIEW
                </p>


                <h2>
                    Assignment Overview
                </h2>

            </div>


            <!-- Opens the full assignment list - Zaki -->
            <a href="/assignments"
               class="text-link">

                View All Assignments

            </a>

        </div>


        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>
                            Assignment
                        </th>

                        <th>
                            Course
                        </th>

                        <th>
                            Due Date
                        </th>

                        <th>
                            Priority
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <!-- Assignment rows are added with JavaScript - Osa -->
                <tbody id="assignmentTable">

                </tbody>


            </table>

        </div>


    </section>


</main>


<!-- Website footer - Osa -->
<footer>

    <p>
        TrackIt | INFR3120 Fall 2026 Project
    </p>

</footer>


</body>

</html>
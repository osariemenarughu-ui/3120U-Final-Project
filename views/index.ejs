<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>
        <%= title %>
    </title>


    <link rel="stylesheet"
          type="text/css"
          href="/stylesheet/style.css">

</head>


<body>


<!-- Navigation Bar -->

<header>

    <div id="brand">

        <div id="logo">
            TI
        </div>


        <div id="brand-text">

            <h1>
                TrackIt
            </h1>

            <p>
                Assignment Tracker
            </p>

        </div>

    </div>


    <nav>

        <a href="/">
            Dashboard
        </a>


        <a href="/create"
           class="nav-button">

            + Create Assignment

        </a>

    </nav>

</header>


<main>


    <!-- Hero Section -->

    <section id="hero">


        <div class="hero-text">

            <p class="small-heading">
                STUDENT DASHBOARD
            </p>


            <h2>
                Stay on top of your school work.
            </h2>


            <p>
                Track assignments, due dates,
                priorities, and progress from
                one simple dashboard.
            </p>

        </div>


        <a href="/create"
           class="primary-button">

            + New Assignment

        </a>


    </section>


    <!-- Dashboard Summary -->

    <section id="summary-section">


        <div class="summary-box">

            <p>
                Total Assignments
            </p>

            <h2>
                0
            </h2>

        </div>


        <div class="summary-box">

            <p>
                To Do
            </p>

            <h2>
                0
            </h2>

        </div>


        <div class="summary-box">

            <p>
                In Progress
            </p>

            <h2>
                0
            </h2>

        </div>


        <div class="summary-box">

            <p>
                Completed
            </p>

            <h2>
                0
            </h2>

        </div>


    </section>


    <!-- Assignment Board -->

    <section class="dashboard-section">


        <div class="section-heading">

            <p class="small-heading">
                ASSIGNMENT BOARD
            </p>


            <h2>
                Current Assignments
            </h2>

        </div>


        <div id="board">


            <!-- To Do -->

            <div class="status-column todo-column">

                <div class="column-title">

                    <span class="status-dot todo-dot">
                    </span>

                    To Do

                </div>


                <p class="empty-text">
                    No assignments yet.
                </p>

            </div>


            <!-- In Progress -->

            <div class="status-column progress-column">

                <div class="column-title">

                    <span class="status-dot progress-dot">
                    </span>

                    In Progress

                </div>


                <p class="empty-text">
                    No assignments yet.
                </p>

            </div>


            <!-- Completed -->

            <div class="status-column complete-column">

                <div class="column-title">

                    <span class="status-dot complete-dot">
                    </span>

                    Completed

                </div>


                <p class="empty-text">
                    No assignments yet.
                </p>

            </div>


        </div>


    </section>


    <!-- Assignment Overview -->

    <section class="dashboard-section">


        <div class="section-heading">

            <p class="small-heading">
                OVERVIEW
            </p>


            <h2>
                Assignment Overview
            </h2>

        </div>


        <div class="table-container">


            <table>


                <thead>

                    <tr>

                        <th>
                            Assignment
                        </th>

                        <th>
                            Course
                        </th>

                        <th>
                            Due Date
                        </th>

                        <th>
                            Priority
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <!--
                    Assignments will be inserted
                    in a later version.
                    -->

                </tbody>


            </table>


            <p class="empty-text">
                No assignments have been created yet.
            </p>


        </div>


    </section>


</main>


<footer>

    <p>
        TrackIt | INFR3120 Fall 2026 Project
    </p>

</footer>


</body>

</html>
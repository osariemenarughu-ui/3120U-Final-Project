<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>
        <%= title %>
    </title>


    <!-- Connects the page to the CSS - Osa -->
    <link rel="stylesheet"
          type="text/css"
          href="/stylesheet/style.css">


    <!-- Loads assignment functions - Osa -->
    <script src="/stylesheet/javascripts/storage.js"></script>


    <!-- Controls the Create Assignment form - Osa -->
    <script src="/stylesheet/javascripts/create.js"></script>

</head>


<body>


<!-- Top navigation bar - Osa -->
<header>

    <!-- Website logo and name - Osa -->
    <div id="brand">

        <div id="logo">
            TI
        </div>


        <div id="brand-text">

            <h1>
                TrackIt
            </h1>

            <p>
                Assignment Tracker
            </p>

        </div>

    </div>


    <!-- Navigation links - Osa -->
    <nav>

        <a href="/">
            Dashboard
        </a>


        <!-- Opens the assignment list - Zaki -->
        <a href="/assignments">
            Assignments
        </a>


        <a href="/create"
           class="nav-button">

            + Create Assignment

        </a>

    </nav>

</header>


<main>


    <!-- Create page heading - Osa -->
    <section class="page-heading">

        <p class="small-heading">
            CREATE
        </p>


        <h2>
            Create Assignment
        </h2>


        <p>
            Add a new assignment to your dashboard.
        </p>

    </section>


    <!-- Assignment form - Osa -->
    <section class="form-section">

        <div class="form-box">


            <form id="assignmentForm"
                  action="/"
                  method="get">


                <!-- Assignment name - Osa -->
                <p>

                    <label for="title">
                        Assignment Name
                    </label>

                    <br>


                    <input type="text"
                           id="title"
                           name="title"
                           required>

                </p>


                <!-- Course name - Osa -->
                <p>

                    <label for="course">
                        Course
                    </label>

                    <br>


                    <input type="text"
                           id="course"
                           name="course"
                           required>

                </p>


                <!-- Assignment due date - Osa -->
                <p>

                    <label for="dueDate">
                        Due Date
                    </label>

                    <br>


                    <input type="date"
                           id="dueDate"
                           name="dueDate"
                           required>

                </p>


                <!-- Priority selection - Osa -->
                <p>

                    <label for="priority">
                        Priority
                    </label>

                    <br>


                    <select id="priority"
                            name="priority">


                        <option value="Low">
                            Low
                        </option>


                        <option value="Medium">
                            Medium
                        </option>


                        <option value="High">
                            High
                        </option>


                    </select>

                </p>


                <!-- Status selection - Osa -->
                <p>

                    <label for="status">
                        Status
                    </label>

                    <br>


                    <select id="status"
                            name="status">


                        <option value="Not Started">
                            Not Started
                        </option>


                        <option value="In Progress">
                            In Progress
                        </option>


                        <option value="Completed">
                            Completed
                        </option>


                    </select>

                </p>


                <!-- Assignment notes - Osa -->
                <p>

                    <label for="description">
                        Description / Notes
                    </label>

                    <br>


                    <textarea id="description"
                              name="description"
                              rows="5"></textarea>

                </p>


                <!-- Form buttons - Osa -->
                <p>

                    <input type="submit"
                           value="Create Assignment">


                    <input type="reset"
                           value="Clear">

                </p>


            </form>


            <a href="/"
               class="secondary-button">

                Back to Dashboard

            </a>


        </div>

    </section>


</main>


<!-- Website footer - Osa -->
<footer>

    <p>
        TrackIt - Organize. Track. Complete.
    </p>

</footer>


</body>

</html>